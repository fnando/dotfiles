Host github.com
  HostName github.com
  User git
  IdentityFile ~/.ssh/github.pub
  IdentitiesOnly yes

Host fnando-server.local
  ServerAliveInterval 15
  ServerAliveCountMax 6
  TCPKeepAlive yes
  ControlMaster no
  ControlPath none

Match host * exec "test -S '%d/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock'"
  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"

Host *
  AddKeysToAgent yes
  #AddressFamily inet
  Compression yes
  ControlMaster auto
  ControlPath ~/.ssh/controlmaster/%C
  ForwardAgent yes
  IdentityFile ~/.ssh/github.pub
  ServerAliveInterval 10
