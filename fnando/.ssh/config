Host github.com
  HostName github.com
  User git
  IdentitiesOnly yes

Host fnando-server.local
  ServerAliveInterval 15
  ServerAliveCountMax 6
  TCPKeepAlive yes
  ControlMaster no
  ControlPath none

Match host * exec "test -n \"$SSH_CONNECTION\""
  IdentityAgent SSH_AUTH_SOCK

Match host * exec "test -S '%d/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock'"
  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"

Host fnando.com fnando.dev fnando-server.local razorblade.local voltage.local
  ForwardAgent yes

Host *
  AddKeysToAgent yes
  #AddressFamily inet
  Compression yes
  ControlMaster auto
  ControlPath ~/.ssh/controlmaster/%C
  IdentityFile ~/.ssh/github
  ServerAliveInterval 10
