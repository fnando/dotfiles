[
  {
    "use_key_equivalents": true,
    "bindings": {
      "ctrl-t": "workspace::NewTerminal",
      "ctrl-`": "workspace::ToggleBottomDock",
      "ctrl-shift-left": "editor::SelectToPreviousSubwordStart",
      "ctrl-shift-right": "editor::SelectToNextSubwordEnd",
      "alt-shift-left": "editor::SelectToPreviousWordStart",
      "alt-shift-right": "editor::SelectToNextWordEnd",
      "ctrl-shift-k": "editor::DeleteLine",
      "ctrl-shift-i": "editor::SelectLargerSyntaxNode", // Expand Selection
      "ctrl-shift-l": "editor::SelectSmallerSyntaxNode", // Shrink Selection
      "f5": "editor::SortLinesCaseInsensitive",
      "cmd-shift-\\": "workspace::ToggleLeftDock",
      "cmd-ctrl-g": "editor::SelectAllMatches",
    },
  },
  {
    "context": "Workspace",
    "bindings": {
      "cmd-r": null,
    },
  },
  {
    "context": "Workspace",
    "bindings": {
      "cmd-w": null,
    },
  },
  {
    "context": "Pane",
    "bindings": {
      "cmd-w": [
        "pane::CloseActiveItem",
        {
          "close_pinned": false,
        },
      ],
    },
  },
  {
    "context": "Editor",
    "bindings": {
      "alt-d": "editor::GoToDeclaration"
    }
  },
  {
    "context": "Editor",
    "unbind": {
      "ctrl-f12": "editor::GoToDeclaration"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "ctrl-alt-d": "editor::GoToDeclarationSplit"
    }
  },
  {
    "context": "Editor",
    "unbind": {
      "ctrl-alt-f12": "editor::GoToDeclarationSplit"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "cmd-|": "workspace::ToggleRightDock"
    }
  },
  {
    "context": "Workspace",
    "unbind": {
      "alt-cmd-b": "workspace::ToggleRightDock"
    }
  },
  {
    "context": "Editor",
    "unbind": {
      "cmd-|": "editor::MoveToEnclosingBracket"
    }
  },
  {
    "unbind": {
      "cmd-shift-w": "workspace::CloseWindow"
    }
  },
  {
    "context": "Editor && mode == full",
    "bindings": {
      "alt-cmd-w": "editor::ToggleSoftWrap"
    }
  },
  {
    "context": "Editor && mode == full",
    "unbind": {
      "cmd-k z": "editor::ToggleSoftWrap"
    }
  }
]
